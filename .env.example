PORT=5000
NODE_ENV=development

# Mongo. Local: mongodb://127.0.0.1:27017/tally
MONGODB_URI=mongodb://127.0.0.1:27017/tally

# Auth — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Must be at least 32 characters each; the two must differ.
JWT_ACCESS_SECRET=replace_me_with_a_long_random_string_at_least_32_chars
JWT_REFRESH_SECRET=replace_me_with_a_different_long_random_string_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Google Sign-In. Only the client ID is needed — the API verifies the ID token
# the browser obtains, so there is no client secret and no redirect callback.
GOOGLE_CLIENT_ID=

# Gemini — language parsing, receipt scanning, summaries, Q&A.
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_VISION_MODEL=gemini-2.5-flash

# Cloudinary — receipt image storage.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000

# Applied to new accounts; the user can change both in onboarding/profile.
DEFAULT_CURRENCY=BDT
DEFAULT_TIMEZONE=Asia/Dhaka
